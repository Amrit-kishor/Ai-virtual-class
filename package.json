{
  "name": "ai-virtual-classroom",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx server/index.ts",
    "dev:concurrent": "concurrently \"tsx server/index.ts\" \"next dev -p 3001\"",
    "dev:server": "tsx server/index.ts",
    "dev:next": "next dev",
    "build": "prisma generate && next build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "test": "tsx tests/livekit_conference.test.ts && tsx tests/production_deployment.test.ts",
    "test:livekit": "tsx tests/livekit_conference.test.ts",
    "test:deployment": "tsx tests/production_deployment.test.ts"
  },
  "dependencies": {
    "@livekit/components-react": "^2.9.24",
    "@livekit/components-styles": "^1.2.0",
    "@mediapipe/camera_utils": "^0.3.1675466862",
    "@mediapipe/selfie_segmentation": "^0.1.1675465747",
    "@types/multer": "^2.2.0",
    "@types/uuid": "^10.0.0",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.4",
    "cors": "^2.8.5",
    "cosine-similarity": "^1.0.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "framer-motion": "^12.4.7",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "livekit-client": "^2.23.0",
    "livekit-server-sdk": "^2.19.2",
    "lucide-react": "^0.475.0",
    "mammoth": "^1.12.0",
    "multer": "^2.2.0",
    "natural": "^8.1.1",
    "next": "^15.1.7",
    "openai": "^7.4.0",
    "pdf-parse": "^2.4.5",
    "pino": "^10.3.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^3.0.1",
    "uuid": "^14.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@prisma/client": "^6.19.3",
    "@types/bcryptjs": "^2.4.6",
