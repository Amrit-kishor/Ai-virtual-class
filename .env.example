# ========================================================
# 1. Vercel Environment Variables (Frontend Deployment)
# ========================================================
BACKEND_URL=https://ai-virtual-class.onrender.com
NEXT_PUBLIC_SOCKET_URL=https://ai-virtual-class.onrender.com
NEXT_PUBLIC_LIVEKIT_ENABLED=true
NEXT_PUBLIC_LIVEKIT_URL=wss://YOUR_LIVEKIT_PROJECT.livekit.cloud

# ========================================================
# 2. Render Environment Variables (Backend Deployment)
# ========================================================
PORT=3000
NODE_ENV=production
FRONTEND_URL=https://YOUR_VERCEL_FRONTEND.vercel.app
JWT_SECRET=supersecret_ai_virtual_classroom_jwt_token_key_2026

# Database Connection
DATABASE_URL=

# OpenAI API Key for AI Teacher & Doubt Solver
OPENAI_API_KEY=your_openai_api_key_here

# LiveKit SFU Cloud Media Infrastructure (Server-Side Secrets)
LIVEKIT_URL=wss://YOUR_LIVEKIT_PROJECT.livekit.cloud
LIVEKIT_API_KEY=YOUR_API_KEY
LIVEKIT_API_SECRET=YOUR_API_SECRET
